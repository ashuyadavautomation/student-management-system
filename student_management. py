import json 

class Student:
    def __init__(self, student_id, name, age, city, hindi, english, math):
        
        self.student_id = student_id
        self.name = name
        self.age = age
        self.city = city
        self.hindi = hindi
        self.english = english
        self.math = math
        
    def total_marks(self):
    	return self.hindi + self.english + self.math
    	
    def average_marks(self):
    	return round(self.total_marks() /
    	3, 2)
    	
    
    def grade (self):
    	average = self.average_marks()
    	
    	if average >= 90:
    		return 'A+'
    		
    	elif average >= 80:
    		return 'A'
    		
    	elif average >= 70:
    		return 'B'
    		
    	elif average >= 60:
    		return 'C'
    		
    	elif average >= 50:
    		return 'D'
    		
    	else:
    		return 'Fail'
    		
    def result(self):
    	if self.hindi >= 33 and self.english >= 33 and self.math >= 33:
    		
    		return 'PASS'
    		
    	else:
    			return 'FAIL'
    			
    def highest_subject(self):
           marks = {
    	          'Hindi': self.hindi,
                  'English': self.english,
                  'Math': self.math
    }
    

           return max(marks, key=marks.get)
           
    def lowest_subject(self):
           marks = {
                     'Hindi': self.hindi,
                     'English': self.english,
                     'Math': self.math
           }

           return min(marks, key=marks.get)
           
    def show_rank(self, rank):
           print('Rank:', rank)
           print('Name:', self.name)
           print('Total Marks:', self.total_marks())
           print('Average:', self.average_marks())
           print('Grade:', self.grade())
           print('Result:', self.result())
           
       
    def show_info(self):
        print('Name:', self.name)
        print('Age:', self.age)
        print('City:', self.city)
        print('Hindi:', self.hindi)
        print('English:', self.english)
        print('Math:', self.math)
        print('Total:', self.total_marks())
        print('Average:', self.average_marks())
        print('Grade:', self.grade())
        print('Result:', self.result())
        print('Highest Marks subject:', self.highest_subject())
        print('Lowest Marks Subject:', self.lowest_subject())
        print('Student ID:', self.student_id)


students = []

def save_students():
       
       data = []
       
       for student in students:
             data.append({
       	         'student_id': student.student_id,
       	         'name': student.name,
       	         'age': student.age,
       	         'city': student.city,
       	         'hindi': student.hindi,
       	         'english': student.english,
       	         'math': student.math
       	         
       	})
       with open('students.json', 'w') as file:
       	json.dump(data, file, indent = 4)
       	
       	print('json file saved successfully!')
      
def load_students():
    try:
        with open('students.json', 'r') as file:
            data = json.load(file)

        for item in data:
            student = Student(
                item['student_id'],
                item['name'],
                item['age'],
                item['city'],
                item['hindi'],
                item['english'],
                item['math']
            )

            students.append(student)

    except FileNotFoundError:
        pass
    
    except json.JSONDecodeError:
        print('students.json file is corrupted!')
        
load_students()

def backup_students():
	try:
		with open('students.json', 'r') as file:
			data = json.load(file)
			
		with open('students_backup.json', 'w') as backup_file:
			json.dump(data, backup_file, indent = 4)
		print('Backup created successfully! ')
		
	except FileNotFoundError:
			print('students.json file not found!')
	
	except json.JSONDecodeError:
			print('Backup file is corrupted!')
			
def restore_backup():
    try:
        with open('students_backup.json', 'r') as backup_file:
            data = json.load(backup_file)

        with open('students.json', 'w') as file:
            json.dump(data, file, indent=4)

        # Memory wali students list ko bhi update karo
        students.clear()

        for item in data:
            student = Student(
                item['student_id'],
                item['name'],
                item['age'],
                item['city'],
                item['hindi'],
                item['english'],
                item['math']
            )

            students.append(student)

        print('Backup restored successfully!')

    except FileNotFoundError:
        print('Backup file not found!')
    
    except json.JSONDecodeError:
    	print('Backup file is corrupted')			
